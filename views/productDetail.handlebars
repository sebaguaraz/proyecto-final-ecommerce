<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <h1>{{title}}</h1>

    <section class="product-detail">
        {{#if thumbnails.[0]}}
        <img src="{{thumbnails.[0]}}" alt="{{title}}" class="product-img">
        {{else}}
        <p>Sin imagen</p>
        {{/if}}

        <p>{{description}}</p>
        <p>Categoría: {{category}}</p>
        <p>Codigo: {{code}}</p>
        <p>Precio: ${{price}}</p>
        <p>Stock: {{stock}}</p>

        {{#if status}}
        {{!-- <button>Agregar al carrito</button> --}}
        <label for="cartId">ID del carrito:</label>
        <input type="text" id="cartId" placeholder="Ingresá el ID del carrito para agrega este producto">

        <button type="button" id="addToCart">
            Agregar al carrito
        </button>

        <div id="message"></div>

        {{else}}

        <p>Producto no disponible</p>

        {{/if}}
    </section>

    <a href="/products">Volver a productos</a>

</body>

<script>

    const button = document.getElementById("addToCart")
    const message = document.getElementById("message")

    async function addProductIntoCart() {

        const cartId = document.getElementById("cartId").value

        if (!cartId) {
            message.textContent = "Ingresá el ID del carrito"
            return
        }

        const response = await fetch(
            `/api/carts/${cartId}/products/{{_id}}`,
            {
                method: "POST"
            }
        )

        const result = await response.json()

        if (response.ok) {
            message.textContent = `Producto agregado correctamente al carrito con ID ${cartId}`
            return
        } else {
            message.textContent = result.detail || "Ocurrió un error"
            return
        }

    }

    if (button) {
        button.addEventListener("click", addProductIntoCart)
    }

</script>

</html>